datasource db {
  provider = "mysql"
 
}

generator client {
  provider = "prisma-client-js"
}

// ====================== UTILISATEURS & ENTREPRISE ======================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  nom           String
  prenom        String?
  role          UserRole @default(USER)
  entrepriseId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entreprise    Entreprise? @relation(fields: [entrepriseId], references: [id])
  factures      Facture[]
  devis         Devis[]
  paiements     Paiement[]
  charges       Charge[]
}

model Entreprise {
  id              String   @id @default(cuid())
  nom             String
  siret           String?  @unique
  adresse         String?
  ville           String?
  codePostal      String?
  pays            String   @default("Cameroun") // ou Gabon, etc.
  telephone       String?
  email           String?
  logoUrl         String?
  currency        String   @default("XAF")     // Devise principale (XAF, EUR, USD...)
  tvaParDefaut    Float    @default(19.25)     // Exemple taux TVA
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  clients         Client[]
  fournisseurs    Fournisseur[]
  taxes           Taxe[]
  factures        Facture[]
  devis           Devis[]
}

// ====================== CLIENTS & FOURNISSEURS ======================
model Client {
  id          String   @id @default(cuid())
  nom         String
  email       String?
  telephone   String?
  adresse     String?
  entrepriseId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entreprise  Entreprise @relation(fields: [entrepriseId], references: [id])
  factures    Facture[]
  devis       Devis[]
}

model Fournisseur {
  id          String   @id @default(cuid())
  nom         String
  email       String?
  telephone   String?
  entrepriseId String
  createdAt   DateTime @default(now())

  entreprise  Entreprise @relation(fields: [entrepriseId], references: [id])
  charges     Charge[]
}

// ====================== FACTURATION & DEVIS ======================
model Facture {
  id              String      @id @default(cuid())
  numero          String      @unique
  type            FactureType @default(FACTURE)
  date            DateTime    @default(now())
  dateEcheance    DateTime?
  statut          FactureStatut @default(BROUILLON)

  totalHT         Decimal     @db.Decimal(12, 2)
  totalTVA        Decimal     @db.Decimal(12, 2)
  totalTTC        Decimal     @db.Decimal(12, 2)
  currency        String      @default("XAF")

  clientId        String
  userId          String
  entrepriseId    String

  client          Client      @relation(fields: [clientId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  entreprise      Entreprise  @relation(fields: [entrepriseId], references: [id])

  lignes          LigneFacture[]
  paiements       Paiement[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Devis {
  id              String      @id @default(cuid())
  numero          String      @unique
  date            DateTime    @default(now())
  dateValidite    DateTime?
  statut          DevisStatut @default(BROUILLON)

  totalHT         Decimal     @db.Decimal(12, 2)
  totalTVA        Decimal     @db.Decimal(12, 2)
  totalTTC        Decimal     @db.Decimal(12, 2)
  currency        String      @default("XAF")

  clientId        String
  userId          String
  entrepriseId    String

  client          Client      @relation(fields: [clientId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  entreprise      Entreprise  @relation(fields: [entrepriseId], references: [id])

  lignes          LigneDevis[]
  factureConvertie Facture?    @relation(fields: [factureId], references: [id])
  factureId       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model LigneFacture {
  id             String  @id @default(cuid())
  description    String
  quantite       Int     @default(1)
  prixUnitaire   Decimal @db.Decimal(12, 2)
  tvaTaux        Float   @default(19.25)
  montantHT      Decimal @db.Decimal(12, 2)
  montantTVA     Decimal @db.Decimal(12, 2)
  montantTTC     Decimal @db.Decimal(12, 2)

  factureId      String
  facture        Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
}

model LigneDevis {
  id             String  @id @default(cuid())
  description    String
  quantite       Int     @default(1)
  prixUnitaire   Decimal @db.Decimal(12, 2)
  tvaTaux        Float   @default(19.25)

  devisId        String
  devis          Devis   @relation(fields: [devisId], references: [id], onDelete: Cascade)
}

// ====================== PAIEMENTS ======================
model Paiement {
  id            String         @id @default(cuid())
  montant       Decimal        @db.Decimal(12, 2)
  datePaiement  DateTime       @default(now())
  modePaiement  ModePaiement
  reference     String?
  statut        PaiementStatut @default(PAYE)

  factureId     String
  userId        String
  entrepriseId  String

  facture       Facture        @relation(fields: [factureId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  entreprise    Entreprise     @relation(fields: [entrepriseId], references: [id])
}

// ====================== CHARGES & FOURNISSEURS ======================
model Charge {
  id              String      @id @default(cuid())
  description     String
  montant         Decimal     @db.Decimal(12, 2)
  dateCharge      DateTime
  categorie       CategorieCharge
  justificatifUrl String?     // Pour photo/fichier (IA OCR plus tard)

  fournisseurId   String?
  userId          String
  entrepriseId    String

  fournisseur     Fournisseur? @relation(fields: [fournisseurId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  entreprise      Entreprise   @relation(fields: [entrepriseId], references: [id])
}

// ====================== IMPÔTS & TAXES ======================
model Taxe {
  id            String   @id @default(cuid())
  nom           String   // TVA, CSS, TPS, Retenue à la source...
  taux          Float
  type          TaxeType
  actif         Boolean  @default(true)
  entrepriseId  String

  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id])
}

// ====================== ENUMS ======================
enum UserRole {
  USER
  ADMIN
  COMPTABLE
}

enum FactureType {
  FACTURE
  AVOIR
}

enum FactureStatut {
  BROUILLON
  EMISE
  PAYEE
  PARTIELLEMENT_PAYEE
  ANNULEE
}

enum DevisStatut {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
}

enum ModePaiement {
  ESPECES
  VIREMENT
  CARTE
  CHEQUE
  MOBILE_MONEY
  AUTRE
}

enum PaiementStatut {
  PAYE
  EN_ATTENTE
  ECHEC
}

enum CategorieCharge {
  ACHAT
  PERSONNEL
  LOGISTIQUE
  LOYER
  TRANSPORT
  MARKETING
  AUTRE
}

enum TaxeType {
  TVA
  RETENUE_SOURCE
  AUTRE
}